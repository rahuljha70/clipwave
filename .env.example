# ─────────────────────────────────────────────────────────────
# Clipwave environment
# Copy to .env.local, fill in what you need, then: npm run dev
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Used to sign/normalise nothing sensitive in the UI but rotate it anyway.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_DAYS=30

# ── Database ────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the local SQLite file (zero setup).
#
# Supabase: Project → Connect → "Transaction pooler" (port 6543). The pooler is
# IPv4 and is the safest choice from Docker/CI/cloud hosts; the direct host
# (db.<ref>.supabase.co:5432) is IPv6-only on newer projects.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
# `sslmode=no-verify` keeps TLS on but skips the pooler's self-signed chain —
# use `sslmode=verify-full` with a CA bundle if you prefer strict verification.
DATABASE_URL=
SQLITE_PATH=data/clipwave.db

# ── Storage ─────────────────────────────────────────────────
STORAGE_DIR=data/storage
MAX_UPLOAD_BYTES=2147483648

# ── Admin bootstrap (npm run seed) ──────────────────────────
ADMIN_EMAIL=admin@clipwave.app
ADMIN_PASSWORD=change-me-now
SEED_DEMO_USER=true
DEMO_EMAIL=demo@clipwave.app
DEMO_PASSWORD=demo12345

# ── Auth: Google OAuth ──────────────────────────────────────
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google AdSense ──────────────────────────────────────────
# Add your approved AdSense publisher ID. The client ID format is ca-pub-##########;
# the ads.txt publisher ID uses pub-########## with the same digits.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ADSENSE_PUBLISHER_ID=
# Optional manual responsive unit ID for the landing page. Auto ads use the client ID above.
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
# Require the AdSense script to load before showing the site. Set false to disable the gate.
NEXT_PUBLIC_ADBLOCK_GATE=true

# ── Email (password resets) ─────────────────────────────────
# Leave empty to write emails to data/outbox/*.eml instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Clipwave <noreply@clipwave.app>

# ── Media acquisition ───────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
PYTHON_BIN=python3
ALLOW_REMOTE_FETCH=true
MAX_SOURCE_SECONDS=10800
# Optional: cookies for content you legitimately have access to.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# ── Speech to text ──────────────────────────────────────────
# local  = faster-whisper (no API key, runs on CPU/GPU)
# openai = Whisper API
# none   = disable transcription (acoustic-only clipping)
STT_PROVIDER=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── LLM (optional) ──────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, Groq, Together, OpenRouter,
# Azure OpenAI, or a local Ollama/LM Studio server.
# Without a key Clipwave uses its built-in deterministic engines.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1500

# ── Billing (optional) ──────────────────────────────────────
# When set, plan changes require checkout instead of self-serve switching.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
